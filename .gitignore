# ==== Env files (secrets) ====
.env
.env.local
.env.*.local
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# ==== Dependencies ====
node_modules/
backend/node_modules/
frontend/node_modules/

# ==== Build output ====
frontend/dist/
frontend/build/
backend/dist/

# ==== Logs ====
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs/

# ==== Uploaded / generated files ====
# Sample placeholder plates ARE tracked (needed for the app to work in prod).
# Only ignore user-uploaded/admin-added plates that shouldn't be in git.
backend/uploads/*
!backend/uploads/sample/
backend/uploads/sample/*
!backend/uploads/sample/*.png
!backend/uploads/sample/README.txt

# ==== OS / editor junk ====
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ==== Internal project tracking (not for repo) ====
PROGRESS.md

# ==== Misc ====
*.zip
coverage/
.cache/